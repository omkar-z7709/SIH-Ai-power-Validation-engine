# Server & Database Configuration
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_doc_checker

# Jev AI Decision Engine Integration (Optional)
# If provided, the system sends structured findings to TypeSafe's Jev model for calibrated decision support.
# If omitted or offline, the platform automatically runs in transparent deterministic fallback mode.
TYPESAFE_API_KEY=
JEV_API_ENDPOINT=https://api.typesafe.ai/v1/decide

# Auth
JWT_SECRET=change-this-to-a-strong-random-secret
DEFAULT_ADMIN_EMAIL=admin@aicte.gov.in
DEFAULT_ADMIN_PASSWORD=ChangeMe@123456
